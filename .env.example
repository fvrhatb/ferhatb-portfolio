# ==== ferhatb.com sunucu ayarları ====
# Bu dosya GİZLİDİR: kimseyle paylaşma, public/ klasörüne koyma.

NODE_ENV=development
PORT=3000

# Oturum çerezlerini imzalamak için rastgele uzun bir değer (değiştirirsen herkesin oturumu kapanır)
SESSION_SECRET=en-az-32-karakter-rastgele-bir-deger

# Appwrite (boş bırakılırsa veriler data/content.json dosyasında tutulur)
# Endpoint ve Project ID: Appwrite Console > projen > Settings (Overview) sayfasında yazar
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=buraya-api-anahtari
APPWRITE_DATABASE_ID=ferbcv
APPWRITE_COLLECTION_ID=content
# Görsellerin tutulduğu Appwrite Storage kovası (yoksa otomatik oluşturulur)
APPWRITE_BUCKET_ID=ferbmedia

# Spotify Web API (secret degeri yalnizca sunucuda kalir)
SPOTIFY_CLIENT_ID=a8d4bffb975a4c3a958750418d6d2720
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://ferhatb.com/api/spotify/callback
# Opsiyonel: 5000-30000 ms; varsayilan 7000
SPOTIFY_CACHE_MS=7000

# Google OAuth 2.0 — yonetim paneli girisi
GOOGLE_CLIENT_ID=31428709079-flqlb66vahjo23n97d0u0bqlcqi3o97g.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_FOUNDER_EMAIL=fvrhatb@gmail.com
GOOGLE_REDIRECT_URI=https://ferhatb.com/api/auth/google/callback
GOOGLE_REDIRECT_URI_LOCAL=http://localhost:3000/api/auth/google/callback
